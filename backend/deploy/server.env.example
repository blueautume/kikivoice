SDKAPPID=YOUR_TENCENT_SDK_APP_ID
SECRETKEY=YOUR_TENCENT_SECRET_KEY
DATABASE_PATH=/var/lib/kikitalk/kikitalk.sqlite3
AVATAR_DIRECTORY=/var/lib/kikitalk/avatars
PUBLIC_BASE_URL=https://kiki.group

# Apple private key and encryption key belong only on the server, never in iOS/Git.
APPLE_CLIENT_ID=com.kikitalk.demo
APPLE_TEAM_ID=A82X46N3WS
APPLE_KEY_ID=6NH7S6KJ92
APPLE_PRIVATE_KEY_PATH=/etc/kikitalk/apple/AuthKey_6NH7S6KJ92.p8
# Generate once with: python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
# Keep this stable and back it up securely alongside encrypted database backups.
APPLE_TOKEN_ENCRYPTION_KEY=YOUR_SERVER_ONLY_FERNET_KEY

# Native APNs is sent only by this account server. Stage both independent
# environment keys privately, then enable after publishing the reviewed API.
# Topic is fixed in code to com.kikitalk.demo. Never reuse the Apple login key.
APNS_ENABLED=0
APNS_TEAM_ID=A82X46N3WS
APNS_SANDBOX_KEY_ID=YOUR_APNS_SANDBOX_KEY_ID
APNS_SANDBOX_PRIVATE_KEY_PATH=/etc/kikitalk/apns/sandbox.p8
APNS_PRODUCTION_KEY_ID=YOUR_APNS_PRODUCTION_KEY_ID
APNS_PRODUCTION_PRIVATE_KEY_PATH=/etc/kikitalk/apns/production.p8

# Keep the gift test login disabled on the public production service.
QA_GIFTS_ENABLED=0

# Independent operations identity. Ordinary KikiTalk Apple login is unchanged.
# Production uses Passkeys; there is no legacy administrator password fallback.
ADMIN_AUTH_MODE=passkey
OPS_BRIDGE_SECRET=REPLACE_WITH_NEW_RANDOM_SERVER_ONLY_256_BIT_OPERATIONS_KEY
ADMIN_TLS_CERT_PATH=/opt/kikitalk/shared/server-certificate.pem
ADMIN_API_SYSTEMD_UNIT=kikitalk.service
