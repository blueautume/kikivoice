[Unit]
Description=KikiTalk account and room API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=kikitalk
Group=kikitalk
WorkingDirectory=/opt/kikitalk
EnvironmentFile=/etc/kikitalk/server.env
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/kikitalk/venv/bin/python -m uvicorn app.main:create_app --factory --host 127.0.0.1 --port 8000 --no-access-log --proxy-headers --forwarded-allow-ips 127.0.0.1 --timeout-keep-alive 5 --limit-concurrency 100 --backlog 128
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/kikitalk
CapabilityBoundingSet=
UMask=0077
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target
