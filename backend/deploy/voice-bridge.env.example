# Append to the account service's existing root-owned 0600 environment file.
VOICE_BRIDGE_ENABLED=1
VOICE_BASE_URL=https://furby.top
# Generate a new random secret (at least 43 characters, 256 bits); deploy the
# identical value ONLY to the account and voice service environment files.
# Never use an Apple key, LiveKit API secret, administrator password or user token.
ACCOUNT_VOICE_BRIDGE_SECRET=replace-with-independent-random-256-bit-secret
