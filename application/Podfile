platform :ios, '14.0'
source 'https://cdn.cocoapods.org/'

# ── Unified TXLiteAVSDK version ──
TXLITEAVSDK_VERSION = '13.4.21067'

# ── Shared dependency definition ──
def shared_pods
  use_frameworks!

  # ── Third-party open source libraries ──
  pod 'Alamofire', '5.0.0'
  # These versions include the maintainers' CocoaPods privacy manifests.
  pod 'SnapKit', '5.7.1'
  pod 'Kingfisher', '7.12.0'
  pod 'AtomicXCore', '4.3.10'
  pod 'RTCRoomEngine/Professional', '4.3.10'
  pod 'Toast-Swift'

  # ── Shell project local pods ──
  pod 'Login',       :path => 'login/Login.podspec'
  pod 'AppAssembly', :path => 'assembly/AppAssembly.podspec'

  # Remote SDK
  pod 'TXLiteAVSDK_Professional', TXLITEAVSDK_VERSION
  pod 'TUICore'

  pod 'MJRefresh', '3.7.5'

  pod 'AtomicX', :path => '../atomic_x/AtomicX.podspec'
  pod 'TUICallKit_Swift/Professional', :path => '../call/'
  pod 'TUILiveKit', :path => '../live/TUILiveKit.podspec'
  pod 'TUIRoomKit', :path => '../room/TUIRoomKit.podspec'
  pod 'TUIChatKit', :path => '../chat/uikit/TUIChatKit.podspec'

end

target 'RTCubeLab' do
  shared_pods

  # Screen-sharing broadcast extension Podfile config
  target 'RTCubeLabReplayExtension' do
    inherit! :search_paths
    pod 'TXLiteAVSDK_Professional/ReplayKitExt', TXLITEAVSDK_VERSION
  end
end

# KikiTalk uses the pinned LiveKit Swift package directly. Tencent pods are
# retained only by the separate RTCubeLab reference target above.

post_install do |installer|
  installer.pods_project.targets.each do |target|
    target.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '14.0'
      config.build_settings['CODE_SIGNING_ALLOWED'] = 'NO'
    end
  end
end
