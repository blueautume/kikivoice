    "required": [
      "eventID",
      "attemptID",
      "operation",
      "stage",
      "severity",
      "code",
      "occurredAt",
      "platform",
      "appVersion",
      "osVersion"
    ],
    "title": "Incident",
    "type": "object"
  },
  "serverEvidence": {
    "requestHeader": "X-Kiki-Attempt-ID UUID可选",
    "responseHeader": "X-Kiki-Request-ID UUID由服务器生成",
    "source": "client|server|account，服务端注入",
    "methods": "POST /v1/rooms、POST /v1/rooms/{id}/token、GET /v1/rooms/{id}/state返回4xx记warning、5xx记error。正常取消/离房不记。",
    "counting": "同一userID+attemptID的create_room/join_room多侧证据合并为一次失败尝试"
  },
  "retention": {
    "days": 7,
    "globalMaxEvents": 10000,
    "userSubmittedPerMinute": 20,
    "userSubmittedPerDay": 100,
    "userServerPerMinute": 30,
    "userServerPerDay": 300,
    "qualityDedupSeconds": 60,
    "timestamps": "occurredAt/receivedAt/trackingSince严格Unix整数秒；最旧7天、未来最多5分钟；elapsedMs整数毫秒",
    "erasure": "注销清全部；撤回按同意epoch清事件并记独立水位。fallback无需user存在，不创建业务用户。",
    "idempotency": "全局eventID唯一，同user+同内容+source重复返回duplicate，改内容或其他用户复用UUID返回409；重复不占配额",
    "trustedLane": "server/account合计30/min300/day，与client提交配额独立",
    "withdrawalWatermarkDays": 32
  },
  "dashboard": {
    "path": "顶层incidents",
    "fields": [
      "schemaVersion",
      "trackingSince",
      "retentionDays",
      "totalEvents",
      "errorsLast24Hours",
      "warningsLast24Hours",
      "failedAttemptsLast24Hours",
      "events"
    ],
    "events": "最近50条Event加userID/userName/source/receivedAt/message",
    "counts": "按occurredAt近24h，failedAttempts为(userID,attemptID)去重create/join失败尝试，不是失败率"
  },
  "query": {
    "publicProxy": "账号 /admin/v2/services/voice/incidents/query，voice只读权限",
    "internalPath": "/internal/admin/v2/incidents/query",
    "method": "POST",
    "signature": "account-voice-ops-v2固定method/path/bodyhash签名，共享nonce池",
    "schema": {
      "additionalProperties": false,
      "properties": {
        "severity": {
          "default": "all",
          "enum": [
            "all",
            "warning",
            "error"
          ],
          "title": "Severity",
          "type": "string"
        },
        "operation": {
          "default": "all",
          "enum": [
            "all",
            "create_room",
            "join_room",
            "room_runtime"
          ],
          "title": "Operation",
          "type": "string"
        },
        "userQuery": {
          "anyOf": [
            {
              "maxLength": 80,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Userquery"
        },
        "limit": {
          "default": 50,
          "maximum": 50,
          "minimum": 1,
          "title": "Limit",
          "type": "integer"
        },
        "cursor": {
          "anyOf": [
            {
              "maxLength": 36,
              "minLength": 36,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cursor"
        }
      },
      "title": "IncidentQuery",
      "type": "object"
    },
    "response": {
      "schemaVersion": 1,
      "events": "同dashboard",
      "nextCursor": "末条eventID或null",
      "retentionDays": 7
    },
    "ordering": "receivedAt DESC,eventID DESC；过期cursor422刷新。userQuery按公开userID/name参数化包含搜索，%_按字面匹配"
  },
  "messages": {
    "request_timeout": "请求超时，未及时取得响应",
    "network_unavailable": "设备网络不可用",
    "network_connection_lost": "网络连接中断",
    "network_tls_failed": "安全连接建立失败",
