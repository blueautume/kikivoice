{
  "schemaVersion": 1,
  "scope": "创建、入房与房内错误/警告诊断；不存Apple身份、token、IP、任意URL、房间/消息正文或原始错误文本。",
  "public": {
    "method": "POST",
    "path": "/v1/telemetry/incidents",
    "authorization": "有效语聊业务Bearer及当前同意；允许语聊封禁用户上报",
    "status": 202,
    "response": {
      "accepted": true,
      "eventID": "原UUID",
      "duplicate": false
    },
    "platform": "只接受ios/ipados；server保留给可信服务观测"
  },
  "fallback": {
    "publicPath": "账号服务器 /v1/voice/incidents",
    "internalPath": "/internal/v1/account/incident",
    "method": "POST",
    "signature": "account-voice-v1换行连接domain,POST,exactPath,timestamp,nonce,SHA256(rawBody)后HMAC-SHA256；共享nonce池。无query/Authorization，精确application/json，重复headers拒绝。",
    "schema": {
      "$defs": {
        "Incident": {
          "additionalProperties": false,
          "properties": {
            "eventID": {
              "maxLength": 36,
              "minLength": 36,
              "title": "Eventid",
              "type": "string"
            },
            "attemptID": {
              "maxLength": 36,
              "minLength": 36,
              "title": "Attemptid",
              "type": "string"
            },
            "operation": {
              "enum": [
                "create_room",
                "join_room",
                "room_runtime"
              ],
              "title": "Operation",
              "type": "string"
            },
            "stage": {
              "enum": [
                "account_authorization",
                "room_api",
                "token_api",
                "media_connect",
                "state_sync",
                "media_runtime",
                "reconnect",
                "safety_sync",
                "chat_sync",
                "audio_policy",
                "room_action",
                "room_leave"
              ],
              "title": "Stage",
              "type": "string"
            },
            "severity": {
              "enum": [
                "warning",
                "error"
              ],
              "title": "Severity",
              "type": "string"
            },
            "code": {
              "enum": [
                "request_timeout",
                "network_unavailable",
                "network_connection_lost",
                "network_tls_failed",
                "network_error",
                "http_unauthorized",
                "http_forbidden",
                "http_not_found",
                "http_conflict",
                "http_rate_limited",
                "http_server_error",
                "http_invalid_response",
                "consent_required",
                "capacity_reached",
                "room_ended",
                "voice_banned",
                "chat_muted",
                "voice_muted",
                "content_filtered",
                "media_connect_timeout",
                "media_connect_failed",
                "media_disconnected",
                "reconnect_failed",
                "state_sync_failed",
                "audio_publish_failed",
                "audio_permission_denied",
                "quality_poor",
                "quality_lost",
                "unknown_error"
              ],
              "maxLength": 40,
              "title": "Code",
              "type": "string"
            },
            "occurredAt": {
              "minimum": 1,
              "title": "Occurredat",
              "type": "integer"
            },
            "elapsedMs": {
              "anyOf": [
                {
                  "maximum": 3600000,
                  "minimum": 0,
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Elapsedms"
            },
            "roomID": {
              "anyOf": [
                {
                  "pattern": "^lk_[a-f0-9]{32}$",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Roomid"
            },
            "requestID": {
              "anyOf": [
                {
                  "maxLength": 36,
                  "minLength": 36,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Requestid"
            },
            "httpStatus": {
              "anyOf": [
                {
                  "maximum": 599,
                  "minimum": 400,
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Httpstatus"
            },
            "platform": {
              "enum": [
                "ios",
                "ipados",
                "server"
              ],
              "title": "Platform",
              "type": "string"
            },
            "appVersion": {
              "maxLength": 32,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9 .()_-]+$",
              "title": "Appversion",
              "type": "string"
            },
            "osVersion": {
              "maxLength": 32,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9 .()_-]+$",
              "title": "Osversion",
              "type": "string"
            }
          },
          "required": [
            "eventID",
            "attemptID",
            "operation",
            "stage",
            "severity",
            "code",
            "occurredAt",
            "platform",
            "appVersion",
            "osVersion"
          ],
          "title": "Incident",
          "type": "object"
        }
      },
      "additionalProperties": false,
      "properties": {
        "accountID": {
          "pattern": "^kiki_[a-zA-Z0-9_]{8,64}$",
          "title": "Accountid",
          "type": "string"
        },
        "name": {
          "maxLength": 16,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "consentEpoch": {
          "maximum": 9223372036854775807,
          "minimum": 1,
          "title": "Consentepoch",
          "type": "integer"
        },
        "lastWithdrawalEpoch": {
          "maximum": 9223372036854775807,
          "minimum": 0,
          "title": "Lastwithdrawalepoch",
          "type": "integer"
        },
        "source": {
          "enum": [
            "client",
            "account"
          ],
          "title": "Source",
          "type": "string"
        },
        "event": {
          "$ref": "#/$defs/Incident"
        }
      },
      "required": [
        "accountID",
        "name",
        "consentEpoch",
        "lastWithdrawalEpoch",
        "source",
        "event"
      ],
      "title": "AccountIncident",
      "type": "object"
    },
    "source": "client只允许ios/ipados；account必须platform=server,appVersion=account-api,osVersion=server"
  },
  "eventSchema": {
    "additionalProperties": false,
    "properties": {
      "eventID": {
        "maxLength": 36,
