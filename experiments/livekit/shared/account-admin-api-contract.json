{
  "schemaVersion": 1,
  "baseURL": "https://kiki.group",
  "serviceID": "account",
  "scope": "Account service only. No voice rooms, voice capacity or voice host metrics. Aggregate statistics only; no personal identifiers.",
  "transport": "HTTPS; Authorization Bearer independent account admin token; no cookies; Cache-Control no-store; no redirects",
  "login": {
    "method": "POST",
    "path": "/admin/v1/auth/session",
    "request": {
      "passphrase": "exact string, 16..256 UTF-8 bytes"
    },
    "responseExample": {
      "token": "opaque-url-safe-43-character-token",
      "expiresAt": 1792396800,
      "serviceID": "account",
      "role": "viewer"
    },
    "limits": "600000 PBKDF2-SHA256; 8 hour viewer sessions; independent 5 per source IP / 5 minutes, 30 global / 5 minutes; max 32 sessions"
  },
  "logout": {
    "method": "DELETE",
    "path": "/admin/v1/auth/session",
    "responseExample": {
      "revoked": true
    }
  },
  "dashboard": {
    "method": "GET",
    "path": "/admin/v1/dashboard",
    "responseExample": {
      "schemaVersion": 1,
      "serverTime": "2026-10-19T02:00:00+00:00",
      "service": {
        "id": "account",
        "name": "Kiki 账号服务",
