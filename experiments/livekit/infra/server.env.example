# Actual file is root-owned /etc/livekit-lab/api.env (0600).
LIVEKIT_URL=http://127.0.0.1:7880
LIVEKIT_PUBLIC_URL=wss://furby.top
LIVEKIT_API_KEY=replace-with-random-api-key
LIVEKIT_API_SECRET=replace-with-random-256-bit-secret
# Production cutover: account mode refuses all laboratory sessions and invites.
VOICE_AUTH_MODE=account
ACCOUNT_VOICE_BRIDGE_SECRET=replace-with-independent-random-256-bit-secret
# A separate lab deployment must explicitly use VOICE_AUTH_MODE=lab and set:
# LAB_ACCESS_CODE=replace-with-private-experiment-invite-code
LAB_DB_PATH=/var/lib/kiki-livekit-lab/lab.sqlite3
LEGAL_DOCUMENTS_PATH=/opt/kiki-livekit-lab/shared/legal_documents.json
# Single-host experiment protection, not a measured production capacity claim.
LAB_MAX_ACTIVE_ROOMS=4
LAB_MAX_ROOM_PARTICIPANTS=32
LAB_MAX_TOTAL_PARTICIPANTS=64
# Distinct authenticated sessions may share Wi-Fi; anonymous limits stay lower.
LAB_HTTP_AUTHENTICATED_IP_LIMIT=18000
# Production operations: central account-service Passkey/ACL is mandatory.
# The voice service accepts only the independent HMAC bridge; no viewer accounts
# or ACLs are stored here and legacy /admin/v1 authentication is disabled.
ADMIN_AUTH_MODE=passkey
OPS_BRIDGE_SECRET=replace-with-independent-random-256-bit-operations-secret
# Clear ADMIN_PASSPHRASE_HASH in production. Legacy isolated fixtures may explicitly
# set ADMIN_AUTH_MODE=legacy and configure the former password login via:
# python -m app.admin hash-password
# ADMIN_PASSPHRASE_HASH=pbkdf2_sha256$600000$<32-hex-salt>$<64-hex-digest>
# Public certificate only. The API must never read the TLS private key.
ADMIN_TLS_CERT_PATH=/opt/kiki-livekit-lab/shared/server-certificate.pem
