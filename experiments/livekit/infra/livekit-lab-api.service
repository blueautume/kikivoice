[Unit]
Description=Kiki LiveKit experiment business API
Wants=network-online.target livekit-lab.service
After=network-online.target livekit-lab.service

[Service]
User=livekit-lab
Group=livekit-lab
WorkingDirectory=/opt/kiki-livekit-lab/backend
EnvironmentFile=/etc/livekit-lab/api.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/kiki-livekit-lab/venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8010 --workers 1 --ws wsproto --no-proxy-headers --no-access-log --log-level warning
Restart=on-failure
RestartSec=3
UMask=0077
StateDirectory=kiki-livekit-lab
StateDirectoryMode=0700
ReadWritePaths=/var/lib/kiki-livekit-lab
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
